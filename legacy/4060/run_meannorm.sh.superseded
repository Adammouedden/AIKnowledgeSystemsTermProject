#!/usr/bin/env bash
# GACA under mean-norm. Identical to runs/gaca except --norm mean.
# Paper Remark 3: mean-and-std normalization drives the per-state optimal
# mixing weight toward 1/2 uniformly, which by Proposition 2 shrinks the gain
# from adapting. This is the controlled test the paper says it did not run.
set -u
cd "$(dirname "$0")"
PIXI="$HOME/.pixi/bin/pixi"
while pgrep -f "train[.]p[y] --method" >/dev/null 2>&1; do sleep 30; done
COMMON=(
  --model Qwen/Qwen2.5-1.5B-Instruct
  --task_types pick_and_place_simple,look_at_obj_in_light
  --max_adm0 20 --n_train 256 --n_eval 64
  --iters 75 --eval_every 15
  --tasks_per_iter 2 --G 8 --max_steps 25
  --gamma 0.95 --invalid_penalty 0.0 --beta_kl 0.01 --norm mean
  --lr 1e-5 --lora_r 32 --clip_eps 0.2
  --rows_per_update 96 --micro_bs 8
  --gen_batch 16 --eval_batch 16 --max_new_tokens 8 --history_len 6
  --seed 0 --time_budget 5.0 --ckpt_every 10 --resume
)
for attempt in 1 2 3; do
  echo "=== $(date -Is) starting gaca mean-norm (attempt $attempt) ==="
  if "$PIXI" run python src/train.py --method gaca --out runs/gaca_mn "${COMMON[@]}" >> runs/gaca_mn.out 2>&1; then
    echo "=== $(date -Is) finished ==="; break
  fi
  echo "=== $(date -Is) attempt $attempt FAILED, resuming ==="; sleep 30
done
"$PIXI" run python src/train.py --method gaca --eval_only runs/gaca_mn_best --out runs/gaca_mn_paired \
  --task_types pick_and_place_simple,look_at_obj_in_light --max_adm0 20 --n_train 256 --n_eval 64 \
  --max_steps 25 --eval_batch 16 --max_new_tokens 8 --history_len 6 --seed 0 2>&1 | tail -2
echo "=== $(date -Is) all done ==="

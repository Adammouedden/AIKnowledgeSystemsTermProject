diff --git a/gigpo/core_gaca.py b/gigpo/core_gaca.py
new file mode 100644
index 0000000..dd93f1a
--- /dev/null
+++ b/gigpo/core_gaca.py
@@ -0,0 +1,50 @@
+"""GRPO / GACA / GACA+reliability inside verl-agent.
+
+A thin adapter: every batch row (one environment step) becomes the step record
+consumed by `gaca_advantages.compute_advantages` -- a symlink to the term
+project's src/advantages.py, the exact code its unit tests pin -- so all
+compared arms share one implementation and differ only in `method` / `rel`.
+
+Row fields used (all present in verl-agent's batch before the advantage step):
+  uid          -> group (prompt group)
+  traj_uid     -> traj
+  token_level_rewards.sum(-1) -> ret (episode reward + that step's invalid
+                  penalty, exactly what verl-agent's GiGPO uses)
+  step_rewards -> g_hat (discounted step return)
+  anchor_obs   -> anchor
+  old_log_probs, response_mask -> nll = H_t, the mean token NLL of the whole
+                  response (reasoning + action), Eq. 4
+"""
+
+import hashlib
+
+import numpy as np
+import torch
+
+from gigpo import gaca_advantages as ADV
+
+
+def _anchor_key(x):
+    return hashlib.md5(repr(x).encode()).hexdigest()[:16]
+
+
+def compute_gaca_family_advantage(token_level_rewards, step_rewards, response_mask, anchor_obs, index, traj_index,
+                                  old_log_probs, method="gaca", norm="mean_std", w=1.0, lam0=0.5, alpha_lam=0.5,
+                                  beta_lam=0.5, alpha_c=1.0, score_mode="entropy", rel="none", seed=0):
+    mask = response_mask.float()
+    ret = token_level_rewards.sum(-1).detach().float().cpu().numpy()
+    g_hat = step_rewards.detach().float().cpu().numpy()
+    nll = (-(old_log_probs.float() * mask).sum(-1) / mask.sum(-1).clamp(min=1)).detach().cpu().numpy()
+    # Step index within a trajectory is only needed by the reward-change
+    # score (alpha_c < 1); rows of one trajectory keep their rollout order.
+    t_of, steps = {}, []
+    for i in range(len(ret)):
+        tr = traj_index[i]
+        t_of[tr] = t_of.get(tr, -1) + 1
+        steps.append({"group": index[i], "traj": tr, "t": t_of[tr], "ret": float(ret[i]), "g_hat": float(g_hat[i]),
+                      "anchor": _anchor_key(anchor_obs[i]), "nll": float(nll[i])})
+    adv, diag = ADV.compute_advantages(steps, method=method, norm=norm, w=w, lam0=lam0, alpha_lam=alpha_lam,
+                                       beta_lam=beta_lam, alpha_c=alpha_c, score_mode=score_mode,
+                                       rng=np.random.default_rng(seed), rel=rel)
+    a = torch.as_tensor(adv, dtype=torch.float32, device=response_mask.device).unsqueeze(-1) * mask
+    return a, a, {f"gaca/{k}": float(v) for k, v in diag.items()}

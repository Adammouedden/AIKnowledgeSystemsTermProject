new file mode 100644
index 0000000..d3f08bd
--- /dev/null
+++ b/gigpo/core_probe.py
@@ -0,0 +1,136 @@
+"""Probe-weighted token credit (term project, IDEAS.md treatment 1).
+
+For each step row with a well-formed response, the commitment probe
+q(c) = P(original action | prompt + response[:c] + "</think>\\n<action>") is
+scored at cut points c every `every` tokens through the reasoning plus the
+<action> tag, with one teacher-forced pass per cut (no generation). The rise
+of q across each segment sets that segment's share of the step's advantage
+via gaca_advantages.probe_token_weights -- the same function the offline
+oracle analysis validated (clipped, mean-preserving, uniform == GACA).
+"""
+
+import re
+
+import numpy as np
+import torch
+
+from gigpo import gaca_advantages as ADV
+
+_ACT = re.compile(r"<action>(.*?)</action>", re.S)
+
+
+def _act_start(tok, ids):
+    """Token index at which '<action>' begins in the decoded response, or None."""
+    text, starts = "", []
+    for t in ids:
+        starts.append(len(text))
+        text += tok.decode([t])
+    k = text.find("<action>")
+    if k < 0:
+        return None
+    for j in range(len(ids)):
+        if starts[j] <= k < (starts[j + 1] if j + 1 < len(ids) else len(text) + 1):
+            return j
+    return None
+
+
+def build_probe_requests(tok, prompts, responses, resp_mask, prompt_mask, every=16):
+    """Returns (requests, rows) where requests = [(row, cut, ctx_ids, tgt_ids)]
+    and rows[row] = (L, cuts) for rows that get probe weights."""
+    close = tok("</think>\n<action>", add_special_tokens=False).input_ids
+    reqs, rows = [], {}
+    for i in range(responses.shape[0]):
+        L = int(resp_mask[i].sum())
+        r = responses[i, :L].tolist()
+        p = prompts[i][prompt_mask[i].bool()].tolist()
+        text = tok.decode(r)
+        if "<think>" not in text or "</think>" not in text:
+            continue
+        m = _ACT.findall(text)
+        a0 = _act_start(tok, r)
+        if not m or a0 is None:
+            continue
+        tgt = tok(m[-1] + "</action>", add_special_tokens=False).input_ids
+        cuts = ADV.probe_cuts(L, a0, every)
+        rows[i] = (L, cuts)
+        for c in cuts:
+            reqs.append((i, c, p + r[:c] + close, tgt))
+    return reqs, rows
+
+
+def weights_from_scores(reqs, rows, scores, n_rows, resp_len, clip=(0.25, 4.0)):
+    """scores[k] = summed log-prob of request k's target. Returns (n_rows, resp_len)
+    weights; rows without a probe keep 1."""
+    w = torch.ones(n_rows, resp_len, dtype=torch.float32)
+    q = {}
+    for (i, c, _, _), s in zip(reqs, scores):
+        q.setdefault(i, {})[c] = float(np.exp(s))
+    for i, (L, cuts) in rows.items():
+        if L == 0 or i not in q:
+            continue
+        ww = ADV.probe_token_weights(L, cuts, [q[i][c] for c in cuts], clip=clip)
+        w[i, :L] = torch.as_tensor(ww, dtype=torch.float32)
+    return w
+
+
+def make_probe_batch(reqs, pad_id):
+    """Left-padded contexts + right-padded targets in verl's (prompt | response) layout."""
+    from verl import DataProto
+
+    P = max(len(c) for _, _, c, _ in reqs)
+    R = max(len(t) for _, _, _, t in reqs)
+    ids, att, resp = [], [], []
+    for _, _, c, t in reqs:
+        ids.append([pad_id] * (P - len(c)) + c + t + [pad_id] * (R - len(t)))
+        att.append([0] * (P - len(c)) + [1] * (len(c) + len(t)) + [0] * (R - len(t)))
+        resp.append(t + [pad_id] * (R - len(t)))
+    ids, att, resp = (torch.tensor(x) for x in (ids, att, resp))
+    pos = (att.cumsum(-1) - 1).clamp(min=0)
+    tmask = torch.zeros(len(reqs), R)
+    for k, (_, _, _, t) in enumerate(reqs):
+        tmask[k, : len(t)] = 1
+    return DataProto.from_dict(tensors={"input_ids": ids, "attention_mask": att, "position_ids": pos,
+                                        "responses": resp}), tmask
+
+
+def sign_mask_weights(w, adv, resp_mask, sign="both"):
+    """sign='pos': keep probe weights only on rows whose advantage is > 0; rows
+    with a zero or negative advantage get uniform weights (GACA), so blame is
+    never concentrated -- if the advantage's sign is wrong, uniform credit
+    dilutes the damage. sign='both' leaves w unchanged."""
+    if sign == "both":
+        return w
+    m = resp_mask.float()
+    row_adv = (adv * m).sum(-1) / m.sum(-1).clamp(min=1)
+    keep = (row_adv > 0).float().unsqueeze(-1)
+    return keep * w + (1 - keep) * m
+
+
+def apply_probe_weights(trainer, batch, every=16, clip=(0.25, 4.0), sign="both"):
+    """Multiply batch.batch['advantages'] by probe token weights. Returns diagnostics."""
+    from verl.protocol import pad_dataproto_to_divisor, unpad_dataproto
+
+    tok = trainer.tokenizer
+    prompts = batch.batch["prompts"]
+    responses = batch.batch["responses"]
+    resp_mask = batch.batch["response_mask"]
+    plen = prompts.shape[1]
+    prompt_mask = batch.batch["attention_mask"][:, :plen]
+    reqs, rows = build_probe_requests(tok, prompts.cpu(), responses.cpu(), resp_mask.cpu(), prompt_mask.cpu(), every)
+    if not reqs:
+        return {"probe/rows": 0.0}
+    pb, tmask = make_probe_batch(reqs, tok.pad_token_id)
+    pb, pad = pad_dataproto_to_divisor(pb, trainer.actor_rollout_wg.world_size)
+    out = trainer.actor_rollout_wg.compute_log_prob(pb)
+    out = unpad_dataproto(out, pad_size=pad)
+    lp = out.batch["old_log_probs"].float().cpu()
+    scores = (lp * tmask).sum(-1).tolist()
+    w = weights_from_scores(reqs, rows, scores, responses.shape[0], responses.shape[1], clip)
+    w = w.to(batch.batch["advantages"].device) * resp_mask.float()
+    w = sign_mask_weights(w, batch.batch["advantages"], resp_mask.to(w.device), sign)
+    batch.batch["advantages"] = batch.batch["advantages"] * w
+    batch.batch["returns"] = batch.batch["advantages"]
+    wm = w[resp_mask.bool()]
+    return {"probe/rows": float(len(rows)) / responses.shape[0], "probe/requests": float(len(reqs)),
+            "probe/w_max_mean": float(torch.stack([w[i][resp_mask[i].bool()].max() for i in rows]).mean()) if rows else 1.0,
+            "probe/w_std": float(wm.std()), "probe/q0_mean": float(np.mean([np.exp(s) for (i, c, _, _), s in zip(reqs, scores) if c == 0]))}

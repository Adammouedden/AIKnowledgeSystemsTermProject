#!/usr/bin/env bash
# Waits for any in-flight run to finish, then trains GACA and GiGPO with the
# same configuration as the GRPO run, and writes the report.
# Safe to re-run: --resume continues each method from its last checkpoint.
set -u
cd "$(dirname "$0")"
PIXI="$HOME/.pixi/bin/pixi"

while pgrep -f "train[.]p[y] --method" >/dev/null 2>&1; do sleep 30; done

COMMON=(
  --model Qwen/Qwen2.5-1.5B-Instruct
  --task_types pick_and_place_simple,look_at_obj_in_light
  --max_adm0 20 --n_train 256 --n_eval 64
  --iters 75 --eval_every 15
  --tasks_per_iter 2 --G 8 --max_steps 25
  --gamma 0.95 --invalid_penalty 0.0 --beta_kl 0.01 --norm mean_std
  --lr 1e-5 --lora_r 32 --clip_eps 0.2
  --rows_per_update 96 --micro_bs 8
  --gen_batch 16 --eval_batch 16 --max_new_tokens 8 --history_len 6
  --seed 0 --time_budget 5.0 --ckpt_every 10 --resume
)

for M in gaca gigpo; do
  echo "=== $(date -Is) starting $M ==="
  "$PIXI" run python src/train.py --method "$M" --out "runs/$M" "${COMMON[@]}" >> "runs/$M.out" 2>&1
  echo "=== $(date -Is) finished $M (exit $?) ==="
done
"$PIXI" run report > runs/report.out 2>&1
echo "=== $(date -Is) all done ==="

+def _dump_steps_impl(trainer, batch, ent):
+    """One JSON line per step row: sampled-token NLL (GACA's H_t), exact mean
+    token entropy, within-response entropy spread, anchor, group ids, returns."""
+    import json, hashlib
+    mask = batch.batch["response_mask"].float().cpu()
+    lp = batch.batch["old_log_probs"].float().cpu()
+    n = mask.sum(-1).clamp(min=1)
+    nll = (-(lp * mask).sum(-1) / n).numpy()
+    e = ent * mask
+    ent_mean = (e.sum(-1) / n).numpy()
+    ent_max = (e.max(-1).values).numpy()
+    ent_sq = ((ent ** 2) * mask).sum(-1) / n
+    ent_std = (ent_sq - torch.as_tensor(ent_mean) ** 2).clamp(min=0).sqrt().numpy()
+    # share of the response's total entropy carried by its top-20% tokens
+    top = []
+    for i in range(len(nll)):
+        v = ent[i][mask[i] > 0]
+        k = max(1, int(round(0.2 * len(v))))
+        top.append(float(v.topk(k).values.sum() / v.sum().clamp(min=1e-9)) if len(v) else 0.0)
+    ret = batch.batch["token_level_rewards"].sum(-1).float().cpu().numpy()
+    g = batch.batch["step_rewards"].float().cpu().numpy() if "step_rewards" in batch.batch.keys() else np.zeros(len(nll))
+    nb = batch.non_tensor_batch
+    with open(os.environ["GACA_STEP_DUMP"], "a") as f:
+        for i in range(len(nll)):
+            f.write(json.dumps({"it": int(trainer.global_steps), "uid": str(nb["uid"][i]), "traj": str(nb["traj_uid"][i]),
+                                "anchor": hashlib.md5(repr(nb["anchor_obs"][i]).encode()).hexdigest()[:16],
+                                "nll": float(nll[i]), "ent": float(ent_mean[i]), "ent_std": float(ent_std[i]),
+                                "ent_max": float(ent_max[i]), "top20": top[i], "len": int(n[i]),
+                                "ret": float(ret[i]), "g_hat": float(g[i])}) + "\n")
+
+

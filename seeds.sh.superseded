#!/usr/bin/env bash
# Seed-variance control: re-run both methods with a different sampling seed.
# Task selection and ordering use Random(1234) independently of --seed, so
# these runs see the same tasks in the same order and differ only in sampling
# randomness. The spread between seeds within a method is the yardstick for
# judging any difference between methods.
set -u
cd "$(dirname "$0")"
PIXI="$HOME/.pixi/bin/pixi"

# No wait loop: a pgrep pattern written into this file also appears in the
# command line of the shell that created it, which matches and hangs forever.
# Launch this only when the GPU is free.

COMMON=(
  --model Qwen/Qwen2.5-1.5B-Instruct
  --task_types pick_and_place_simple,look_at_obj_in_light
  --max_adm0 20 --n_train 256 --n_eval 64
  --iters 75 --eval_every 15
  --tasks_per_iter 2 --G 8 --max_steps 25
  --gamma 0.95 --invalid_penalty 0.0 --beta_kl 0.01 --norm mean_std
  --lr 1e-5 --lora_r 32 --clip_eps 0.2
  --rows_per_update 96 --micro_bs 8
  --gen_batch 16 --eval_batch 16 --max_new_tokens 8 --history_len 6
  --seed 1 --time_budget 5.0 --ckpt_every 10 --resume
)

for M in grpo gaca; do
  for attempt in 1 2 3; do
    echo "=== $(date -Is) starting ${M} seed1 (attempt $attempt) ==="
    if "$PIXI" run python src/train.py --method "$M" --out "runs/${M}_s1" "${COMMON[@]}" >> "runs/${M}_s1.out" 2>&1; then
      echo "=== $(date -Is) ${M} seed1 done ==="; break
    fi
    echo "=== $(date -Is) ${M} seed1 attempt $attempt FAILED, resuming ==="; sleep 30
  done
  if [ -d "runs/${M}_s1_best" ]; then
    "$PIXI" run python src/train.py --method "$M" --eval_only "runs/${M}_s1_best" --out "runs/${M}_s1_paired" \
      --model Qwen/Qwen2.5-1.5B-Instruct --task_types pick_and_place_simple,look_at_obj_in_light \
      --max_adm0 20 --n_train 256 --n_eval 64 --max_steps 25 --eval_batch 16 \
      --max_new_tokens 8 --history_len 6 --seed 0 >> "runs/${M}_s1.out" 2>&1
  fi
done
echo "=== $(date -Is) seed runs done ==="
